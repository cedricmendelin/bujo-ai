@page "/lists/{ListId:guid}"
@attribute [Authorize(Policy = "ApprovedUi")]
@rendermode InteractiveServer
@inherits JournalPage

<PageTitle>List · Bujo-AI</PageTitle>
<div data-requires-circuit>
    <h1 tabindex="-1">@(_list?.Name ?? "List details")</h1>
    @if (_list?.WeekKey is { } listWeek)
    {
        <p class="journal-meta">Week number @listWeek.Week · Week year @listWeek.Year</p>
    }
    <NotationLegend />
    <p><a href="/lists">All lists</a></p>
    <JournalFeedback Error="@Error" Confirmation="@Confirmation" Ready="@Ready" Busy="@Busy" Refresh="RefreshAsync" />
    @if (_list is { } list)
    {
        <p class="journal-meta">@list.State</p>
        @if (list.GoalText is { } goal)
        {
            <p class="journal-text">Saved goal: @goal</p>
        }
        <h2>Items in this list</h2>
        @if (_rows.Length == 0)
        {
            <p>No items in this list.</p>
        }
        else
        {
            <ul class="journal-rows" role="list">
                @foreach (var row in _rows)
                {
                    <li class="journal-entry">
                        @if (row.Item.Type == ItemType.Task && list.State == JournalListState.Open && row.Occurrence.State == OccurrenceState.Open)
                        {
                            <button type="button" class="task-notation"
                                    aria-label="@($"Complete {row.Item.Name}")"
                                    disabled="@(Busy || !Ready)"
                                    @onclick="() => CompleteOccurrenceAsync(row.Occurrence)">
                                <JournalMarker Type="@row.Item.Type.ToString()" State="row.Occurrence.State" />
                            </button>
                        }
                        else
                        {
                            <JournalMarker Type="@row.Item.Type.ToString()" State="row.Occurrence.State" />
                        }
                        @if (_focusOccurrence == row.Occurrence.Id)
                        {
                            <a class="journal-entry-text" href="/items/@row.Occurrence.Id" @ref="_completedItemLink">@row.Item.Name</a>
                        }
                        else
                        {
                            <a class="journal-entry-text @(row.Occurrence.State == OccurrenceState.Abandoned ? "is-abandoned" : null)" href="/items/@row.Occurrence.Id">@row.Item.Name</a>
                        }
                        @if (row.Latest is { } latest)
                        {
                            <div>Latest: <a href="/items/@latest.CurrentOccurrence.Id">@latest.CurrentList.Name · @JournalLabels.State(row.Item.Type, latest.CurrentOccurrence.State)</a></div>
                        }
                    </li>
                }
            </ul>
        }
        <form method="post" data-journal-write data-journal-form @onsubmit="SaveGoalAsync" @onsubmit:preventDefault>
            <fieldset class="journal-form" disabled="@(Busy || !Ready)">
                <legend>Edit list goal</legend>
                <label for="list-goal">Goal (optional)</label>
                <textarea id="list-goal" maxlength="@DomainLimits.GoalText" @bind="_goalDraft" @bind:event="oninput"></textarea>
                <button type="submit">Save goal</button>
            </fieldset>
        </form>
        @if (list.Kind != JournalListKind.FutureLog)
        {
            <div class="journal-actions" data-journal-write data-journal-form>
                @if (list.State == JournalListState.Open)
                {
                    <a href="/lists/@list.Id/review">Start review</a>
                }
                <button type="button" disabled="@(Busy || !Ready)" @onclick="ChangeStateAsync">@(list.State == JournalListState.Open ? "Close list" : "Reopen list")</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid ListId { get; set; }
    private JournalListSnapshot? _list;
    private ListRow[] _rows = [];
    private string? _goalDraft;
    private Guid? _focusOccurrence;
    private ElementReference _completedItemLink;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_focusOccurrence is not null)
        {
            _focusOccurrence = null;
            await _completedItemLink.FocusAsync();
        }
    }

    protected override void Read()
    {
        var snapshot = Journal.GetSnapshot();
        var previous = _list;
        var list = snapshot.Lists.SingleOrDefault(list => list.Id == ListId);
        if (list is null)
            throw new DomainException(DomainErrorCode.NotFound, "The list was not found.");
        var items = snapshot.Items.ToDictionary(item => item.Id);
        _rows = snapshot.Occurrences.Where(occurrence => occurrence.ListId == ListId)
            .OrderBy(occurrence => occurrence.CreatedAt).ThenBy(occurrence => occurrence.Id)
            .Select(occurrence => new ListRow(occurrence, items[occurrence.ItemId],
                occurrence.State == OccurrenceState.Moved ? snapshot.Resolve(occurrence.Id).Value : null)).ToArray();
        if (previous is null || _goalDraft == previous.GoalText) _goalDraft = list.GoalText;
        _list = list;
    }

    private Task SaveGoalAsync() => SaveAsync(
        () => WithCurrentList(() => Journal.SetListGoal(ListId, _goalDraft)),
        list => { _goalDraft = list.GoalText; _list = list; return "Goal saved."; });

    private Task CompleteOccurrenceAsync(OccurrenceSnapshot displayed) => SaveAsync(
        () =>
        {
            var latest = Journal.Resolve(displayed.Id);
            if (!latest.IsSuccess)
                return DomainResult<OccurrenceSnapshot>.Failure(latest.Error!);
            if (latest.Value!.CurrentOccurrence != displayed)
                return DomainResult<OccurrenceSnapshot>.Failure(
                    new(DomainErrorCode.StaleOccurrence, "The occurrence has changed."));
            return Journal.Transition(displayed.Id, OccurrenceAction.Done);
        },
        saved =>
        {
            _focusOccurrence = displayed.Id;
            return $"Item is now {saved.State.ToString().ToLowerInvariant()}.";
        });

    private Task ChangeStateAsync()
    {
        var close = _list!.State == JournalListState.Open;
        return SaveAsync(() => WithCurrentList(() => close ? Journal.CloseList(ListId) : Journal.ReopenList(ListId)),
            _ => close ? "List closed." : "List reopened.");
    }

    private DomainResult<JournalListSnapshot> WithCurrentList(Func<DomainResult<JournalListSnapshot>> command) =>
        Journal.GetSnapshot().Lists.SingleOrDefault(list => list.Id == ListId)?.Version == _list!.Version
            ? command()
            : DomainResult<JournalListSnapshot>.Failure(new(DomainErrorCode.ConcurrencyConflict, "This list changed since it was opened."));

    private sealed record ListRow(OccurrenceSnapshot Occurrence, ItemSnapshot Item, ItemResolution? Latest);
}
