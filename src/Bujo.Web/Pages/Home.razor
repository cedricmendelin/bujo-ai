@page "/"
@attribute [AllowAnonymous]
@inject IConfiguration Configuration

<AuthorizeView Policy="ApprovedUi">
    <Authorized>
        @if (Configuration.GetValue<bool>("Chat:Enabled"))
        {
            <PageTitle>Chat · Bujo-AI</PageTitle>
            <ChatInterface @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
        }
        else
        {
            <PageTitle>Chat unavailable · Bujo-AI</PageTitle>
            <h1 tabindex="-1">Chat unavailable</h1>
            <p>Journal chat is off or unavailable. Your journal remains available.</p>
            <div class="journal-actions">
                <a href="/today">Today</a>
                <a href="/capture">Capture</a>
                <a href="/lists">Lists</a>
                <a href="/upcoming">Upcoming</a>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <PageTitle>Bujo-AI</PageTitle>
        <section class="auth-card" aria-labelledby="welcome-heading">
            <p class="eyebrow">Space for your everyday</p>
            <h1 id="welcome-heading">Your bullet journal</h1>
            <p>Capture thoughts and tasks, organize them in lists, and review what you planned.</p>
            <p><a class="button-link" href="/auth/sign-in" data-enhance-nav="false">Sign in to your journal</a></p>
        </section>
    </NotAuthorized>
</AuthorizeView>
