@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Bujo-AI home" data-enhance-nav="false">Bujo-AI</a>
        <nav aria-label="Primary navigation">
            <AuthorizeView Policy="ApprovedUi">
                <Authorized>
                    <NavLink href="/" Match="NavLinkMatch.All">Chat</NavLink>
                    <NavLink href="/today">Today</NavLink>
                    <NavLink href="/upcoming">Upcoming</NavLink>
                    <NavLink href="/capture">Capture</NavLink>
                    <NavLink href="/knowledge">Knowledge</NavLink>
                    <NavLink href="/lists">Lists</NavLink>
                    <span class="account-state">Signed in</span>
                    <a href="/auth/sign-out" data-enhance-nav="false">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/" data-enhance-nav="false">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main id="main-content" tabindex="-1">
        @Body
    </main>
</div>
