@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Bujo-AI home" data-enhance-nav="false">Bujo-AI</a>
        <nav aria-label="Primary navigation">
            <AuthorizeView Policy="ApprovedUi">
                <Authorized>
                    <NavLink href="/" Match="NavLinkMatch.All" data-enhance-nav="false">Today</NavLink>
                    <NavLink href="/upcoming" data-enhance-nav="false">Upcoming</NavLink>
                    <NavLink href="/capture" data-enhance-nav="false">Capture</NavLink>
                    <NavLink href="/lists" data-enhance-nav="false">Lists</NavLink>
                    <a href="/rendering-proof" data-enhance-nav="false">Diagnostics</a>
                    <span class="account-state">Signed in</span>
                    <a href="/auth/sign-out" data-enhance-nav="false">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/auth/sign-in" data-enhance-nav="false">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <aside class="connection-panel" aria-label="Connection status">
        <p data-connectivity-status role="status" aria-live="polite" aria-atomic="true">
            Checking browser connection…
        </p>
        <p data-circuit-status role="status" aria-live="polite" aria-atomic="true" hidden></p>
        <noscript>
            <p>JavaScript is required for the interactive app and connection warnings.</p>
        </noscript>
    </aside>

    <main id="main-content" tabindex="-1" data-enhance-nav="false">
        @Body
    </main>
    <footer>No journal data is stored offline. An internet connection is required to open the app.</footer>
</div>
