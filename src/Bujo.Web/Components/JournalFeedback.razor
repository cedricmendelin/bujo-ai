@if (Error is not null)
{
    <div class="journal-error">
        <p role="alert">@Error</p>
        <button type="button" disabled="@Busy" @onclick="Refresh">Refresh journal</button>
    </div>
}
<p class="journal-confirmation" role="status">@Confirmation</p>
@if (!Ready && Error is null)
{
    <p role="status">Loading the journal…</p>
}

@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Confirmation { get; set; }
    [Parameter] public bool Ready { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
}
