@if (Items.Count == 0)
{
    <p>No items.</p>
}
else
{
    <ul class="journal-rows" role="list">
        @foreach (var item in Items)
        {
            <li class="journal-entry">
                <JournalMarker State="@(Enum.Parse<OccurrenceState>(item.Destination.State))" />
                <a id="review-item-@item.ItemId" class="journal-entry-text" href="/items/@item.Destination.OccurrenceId">@item.Text</a>
                <span class="journal-meta"> · @JournalLabels.Period(item.PlannedPeriod)</span>
                <div>@item.Reason <a href="/lists/@item.Destination.ListId">@item.Destination.ListName</a></div>
                @if (item.Conflict)
                {
                    <strong>Planned period conflicts with the destination week.</strong>
                }
                @if (item.Tags.Count > 0)
                {
                    <div class="journal-meta">Tags: @string.Join(", ", item.Tags)</div>
                }
                @if (ShowOverdueActions && ReviewDate is { } today && IsOverdue(item))
                {
                    var week = IsoWeekKey.FromDate(today);
                    <div class="journal-actions">
                        <button type="button" disabled="@Busy"
                                aria-label="Plan for today · @today.ToString("yyyy-MM-dd") for @item.Text"
                                @onclick="() => PlanForToday.InvokeAsync(item)">
                            Plan for today · @today.ToString("yyyy-MM-dd")
                        </button>
                        <button type="button" disabled="@Busy"
                                aria-label="Plan for this week · @week for @item.Text"
                                @onclick="() => PlanForThisWeek.InvokeAsync(item)">
                            Plan for this week · @week
                        </button>
                    </div>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlannedReviewItem> Items { get; set; } = [];
    [Parameter] public bool ShowOverdueActions { get; set; }
    [Parameter] public DateOnly? ReviewDate { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<PlannedReviewItem> PlanForToday { get; set; }
    [Parameter] public EventCallback<PlannedReviewItem> PlanForThisWeek { get; set; }

    private static bool IsOverdue(PlannedReviewItem item) =>
        item.ReasonCode is "MissedDay" or "MissedWeek" or "MissedMonth" or "MissedQuarter" or "MissedYear";
}
