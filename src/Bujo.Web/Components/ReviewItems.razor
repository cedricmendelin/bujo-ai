@if (Items.Count == 0)
{
    <p>No items.</p>
}
else
{
    <ul class="journal-rows" role="list">
        @foreach (var item in Items)
        {
            <li class="journal-entry">
                <JournalMarker Type="@item.Type.ToString()" State="@(Enum.Parse<OccurrenceState>(item.Destination.State))" />
                <a class="journal-entry-text" href="/items/@item.Destination.OccurrenceId">@item.Text</a>
                <span class="journal-meta"> · @JournalLabels.Period(item.PlannedPeriod)</span>
                <div>@(item.Type == ItemType.Thought && item.ReasonCode == "FutureLog" ? "Reflection in the Future Log." : item.Reason) <a href="/lists/@item.Destination.ListId">@item.Destination.ListName</a></div>
                @if (item.Conflict)
                {
                    <strong>Planned period conflicts with the destination week.</strong>
                }
                @if (item.Tags.Count > 0)
                {
                    <div class="journal-meta">Tags: @string.Join(", ", item.Tags)</div>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlannedReviewItem> Items { get; set; } = [];
}
